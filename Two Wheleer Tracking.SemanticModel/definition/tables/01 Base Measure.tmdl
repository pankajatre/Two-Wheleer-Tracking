table '01 Base Measure'
	lineageTag: 35437399-c27f-4841-808b-35eb2bcc71d7

	measure 'Total Service' = COUNTROWS('Fact Service Raw')
		lineageTag: 56d577b4-95db-48fc-b4ea-6be5894d647e

		changedProperty = IsHidden

	measure 'Total Vehicles' =
			
			
			VAR SelectedYear =
			    SELECTEDVALUE(Dim_Date[Year])
			
			VAR MaxSalesDate =
			    CALCULATE(
			        MAX('Fact Sales Org Input'[Invoice_Date]),
			        ALL(Dim_Date)
			    )
			
			VAR MaxServiceDate =
			    CALCULATE(
			        MAX('Fact Service Raw'[Job_Card_Closed_Date]),
			        ALL(Dim_Date)
			    )
			
			VAR MaxDate =
			    IF(MaxSalesDate >= MaxServiceDate, MaxSalesDate, MaxServiceDate)
			
			VAR CutOffDate =
			    DATE(
			        SelectedYear,
			        MONTH(MaxDate),
			        DAY(MaxDate)
			    )
			
			VAR SalesChassis =
			    CALCULATETABLE(
			        VALUES('Fact Sales Org Input'[Frame]),
			        ALL(Dim_Date),
			        Dim_Date[Date] <= CutOffDate
			    )
			
			VAR ServiceChassis =
			    CALCULATETABLE(
			        VALUES('Fact Service Raw'[Frame_Number]),
			        ALL(Dim_Date),
			        Dim_Date[Date] <= CutOffDate
			    )
			
			RETURN
			COUNTROWS(
			    DISTINCT(
			        UNION(
			            SalesChassis,
			            ServiceChassis
			        )
			    )
			)
		formatString: 0
		lineageTag: 56540ee3-b25c-4f6a-8f33-a02f7ccb0269

		changedProperty = IsHidden

	measure 'Total Service Conversation %' = DIVIDE([Total Service],[Total Vehicles New])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 691d4a7f-cde0-4e87-a90f-b4dff01d172a

		changedProperty = IsHidden

	measure 'Avg Services Per Chassis' =
			
			DIVIDE(
			    [Total Service],
			   [Total Vehicles],
			    0
			)
		lineageTag: faf26346-2f17-447c-9828-a49563ff9643

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Job Card Max Date' = CALCULATE(MAX('Fact Service Raw'[Job_Card_Closed_Date]),ALL(Dim_Date))
		formatString: Short Date
		lineageTag: a9105e1f-0c56-4c61-82b8-ff5b6b21c39e

		changedProperty = IsHidden

	measure 'Min Date' = MIN('Fact Service Raw'[Job_Card_Closed_Date])
		formatString: General Date
		lineageTag: bd6f3a6e-1774-4caa-bbf0-c18aa1f2ae03

		changedProperty = IsHidden

	measure 'Total Vehicles Sold' = COUNTROWS('Fact Sales Org Input')
		formatString: 0
		lineageTag: 1856bbca-3c75-45de-ac09-b0df79ed040e

		changedProperty = IsHidden

	measure 'Total Job Cards' = DISTINCTCOUNT('Fact Service Raw'[Job_Card_Number])
		formatString: 0
		lineageTag: efb6b98f-080b-46e1-a46d-b0cccd669d03

		changedProperty = IsHidden

	measure 'Total Service Revenue' = SUM('Fact Service Raw'[Total_Job_Card_Revenue])
		formatString: 0
		lineageTag: 0ac20c48-80ff-41a0-b47f-9b9de9ec87db

		changedProperty = IsHidden

	measure 'Average Revenue per Job Card' = DIVIDE([Total Service Revenue],[Total Job Cards])
		lineageTag: 734d31f9-7896-4d44-8560-ad5fc1d349cc

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Vehicles New' =
			
			VAR CurrentFY =
			    SELECTEDVALUE(Dim_Date[Fiscal Year])
			
			VAR FYStartYear =
			    VALUE(LEFT(CurrentFY, 4))
			
			VAR FYEndDate =
			    DATE(FYStartYear + 1, 3, 31)
			
			VAR MaxSalesDate =
			    CALCULATE(
			        MAX('Fact Sales Org Input'[Invoice_Date]),
			        REMOVEFILTERS(Dim_Date)
			    )
			
			VAR MaxServiceDate =
			    CALCULATE(
			        MAX('Fact Service Raw'[Job_Card_Closed_Date]),
			        REMOVEFILTERS(Dim_Date)
			    )
			
			VAR OverallMaxDate =
			    MAX(MaxSalesDate, MaxServiceDate)
			
			VAR CutOffDate =
			    MIN(FYEndDate, OverallMaxDate)
			
			VAR SalesChassis =
			    CALCULATETABLE(
			        VALUES('Fact Sales Org Input'[Frame]),
			        REMOVEFILTERS(Dim_Date),
			        REMOVEFILTERS('Dim Location'[Location]),
			        REMOVEFILTERS('Dim Model'[Model]),
			        'Fact Sales Org Input'[Invoice_Date] <= CutOffDate
			    )
			
			VAR ServiceChassis =
			    CALCULATETABLE(
			        VALUES('Fact Service Raw'[Frame_Number]),
			        REMOVEFILTERS(Dim_Date),
			        REMOVEFILTERS('Dim Location'[Location]),
			        REMOVEFILTERS('Dim Model'[Model]),
			        'Fact Service Raw'[Job_Card_Closed_Date] <= CutOffDate
			    )
			
			RETURN
			    COUNTROWS(
			        DISTINCT(
			            UNION(
			                SalesChassis,
			                ServiceChassis
			            )
			        )
			    )
		formatString: 0
		lineageTag: 23ead702-6a8b-41e0-94fc-de033bc29392

		changedProperty = IsHidden

	measure 'Total EW PLUS' =
			CALCULATE(DISTINCTCOUNT(Fact_AMC_EW_Master[Invoice_Number]),
			                        'Fact_AMC_EW_Master'[Order_SubType] = "EW PLUS")
		formatString: 0
		lineageTag: 73e9d341-22d0-45b3-a7ab-ab708a4c2b43

	measure 'PYC LABOUR' = DIVIDE([Labour Excl GST],[Total Service])
		lineageTag: 4fb35faa-bbe6-444a-ba9d-3f12b172d9b2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'PYC LUBES' = DIVIDE([Total Lubes Revenue],[Total Service])
		lineageTag: 28d39361-ddd5-4484-8297-2e0967631daf

