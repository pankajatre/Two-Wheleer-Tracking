table '06 Delta'
	lineageTag: 174912a8-a110-497c-9a82-cb9e3537ecd5

	measure 'SMPL Service Growth delta %' = [Total Service Conversation %] - CALCULATE([Total Service Conversation %],SAMEPERIODLASTYEAR(dim_date[Date]))
