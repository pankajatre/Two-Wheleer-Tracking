	column 'Age Bucket' =
			SWITCH(TRUE(),
			'Dim Chassis'[Vechele Age Month] <= 12,"0-1 year",
			'Dim Chassis'[Vechele Age Month] > 12 && 'Dim Chassis'[Vechele Age Month] <= 24,"1-2 year",
			'Dim Chassis'[Vechele Age Month] > 24 && 'Dim Chassis'[Vechele Age Month] <= 36,"2-3 year",
			'Dim Chassis'[Vechele Age Month] > 36 && 'Dim Chassis'[Vechele Age Month] <= 48,"3-4 year",
			'Dim Chassis'[Vechele Age Month] > 48 && 'Dim Chassis'[Vechele Age Month] <= 60,"4-5 year",
			'Dim Chassis'[Vechele Age Month] > 60 && 'Dim Chassis'[Vechele Age Month] <= 72,"5-6 year",
			'Dim Chassis'[Vechele Age Month] > 72 && 'Dim Chassis'[Vechele Age Month] <= 84,"6-7 year",
			'Dim Chassis'[Vechele Age Month] > 84, "8+ year"
			)
		lineageTag: 59bf4056-e8a9-4266-8984-1750077f1b4f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

