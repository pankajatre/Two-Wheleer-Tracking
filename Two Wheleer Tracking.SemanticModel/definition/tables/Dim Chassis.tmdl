	partition 'Dim Chassis' = m
		mode: import
		source =
				let
				    Source = Sql.Databases("DESKTOP-M0KE14I\MSSQLSERVERSHYAM"),
				    Honda = Source{[Name="Honda"]}[Data],
				    dbo_Vehicle_Service_Tracking = Honda{[Schema="dbo",Item="Vehicle_Service_Tracking"]}[Data],
				    #"Changed Type" = Table.TransformColumnTypes(dbo_Vehicle_Service_Tracking,{{"Invoice_Date", type date}}),
				    #"Trimmed Text" = Table.TransformColumns(#"Changed Type",{{"Address", Text.Trim, type text}}),
				    #"Capitalized Each Word" = Table.TransformColumns(#"Trimmed Text",{{"Address", Text.Proper, type text}}),
				    #"Added Custom" = Table.AddColumn(#"Capitalized Each Word", "Colony", each let
				    AddressText = Text.Upper(Text.From([Address])),
				    Matches =
				        List.Select(
				            #"Colony List",
				            each Text.Contains(
				                AddressText,
				                Text.Upper(Text.From(_)),
				                Comparer.OrdinalIgnoreCase
				            )
				        )
				in
				    if List.Count(Matches) > 0 then Matches{0} else null),
				    #"Merged Queries2" = Table.NestedJoin(#"Added Custom", {"Colony"}, Indore_Ward, {"Locality_Area"}, "Indore_Ward", JoinKind.LeftOuter),
				    #"Expanded Indore_Ward" = Table.ExpandTableColumn(#"Merged Queries2", "Indore_Ward", {"Honda_Near_by"}, {"Honda_Near_by"}),
				    #"Renamed Columns2" = Table.RenameColumns(#"Expanded Indore_Ward",{{"Honda_Near_by", "Near_by_Centre"}})
				in
				    #"Renamed Columns2"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Exception

