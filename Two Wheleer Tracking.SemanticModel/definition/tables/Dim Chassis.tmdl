	column 'SERVICE STATUS' = ```
			
			 VAR SaleDate = 
			    'Dim Chassis'[Invoice_Date]
			
			VAR LastServiceDate =
			    'Dim Chassis'[Last Service Date]
			
			VAR FirstLoginDate = 
			    'Dim Chassis'[First System Login Date]
			
			VAR LastServiceType =
			    UPPER(
			        TRIM(
			            'Dim Chassis'[Last Service Type]
			        )
			    )
			
			VAR TotalServiceCount =
			    COALESCE(
			        'Dim Chassis'[Total Service Cnt],
			        0
			    )
			
			VAR PaidServiceCount =
			    COALESCE(
			        'Dim Chassis'[Total Paid Cnt],
			        0
			    )
			
			VAR SaleDays =
			    DATEDIFF(
			        SaleDate,
			        TODAY(),
			        DAY
			    )
			
			VAR LoginDays =
			    DATEDIFF(
			        FirstLoginDate,
			        TODAY(),
			        DAY
			    )   
			
			VAR ServiceDays =
			    IF(
			        NOT ISBLANK(LastServiceDate),
			        DATEDIFF(
			            LastServiceDate,
			            TODAY(),
			            DAY
			        )
			    )
				
				RETURN
			SWITCH(TRUE(),
				 /* =====================================================
			       FIRST FREE SERVICE
			       ===================================================== */
			
			    TotalServiceCount = 0
			        && SaleDays < 15,
			        "NEW VEHICLE",
			
			    TotalServiceCount = 0
			        && IF(ISBLANK(SaleDays),LoginDays,SaleDays) >= 15
			        && IF(ISBLANK(SaleDays),LoginDays,SaleDays) <= 30,
			        
			        "CALL FOR FIRST SERVICE",
			
			    TotalServiceCount = 0
			        && IF(ISBLANK(SaleDays),LoginDays,SaleDays) > 30
			        && IF(ISBLANK(SaleDays),LoginDays,SaleDays) < 155,
			        "FS MISSED",
			
			        /* =====================================================
			       SECOND FREE SERVICE
			       ===================================================== */
			     --ISBLANK('Dim Chassis'[ACTIVE]) &&
			    TotalServiceCount = 0 
			        && SaleDays >= 155
			        && SaleDays <= 180,
			        "CALL FOR SECOND SERVICE",
			     --ISBLANK('Dim Chassis'[ACTIVE])   &&
			    LastServiceType = "FREE 01"
			        && SaleDays >= 155
			        && SaleDays <= 180,
			        "CALL FOR SECOND SERVICE",
			     --ISBLANK('Dim Chassis'[ACTIVE])   &&
			    LastServiceType = "FREE 01"
			        && SaleDays > 180
			        && SaleDays < 350,
			        "SS MISSED",
			    -- ISBLANK('Dim Chassis'[ACTIVE])   &&
			    TotalServiceCount = 0
			        && SaleDays > 180
			        && SaleDays < 350,
			        "SS MISSED",
			    
			        //* =====================================================
			     --  THIRD FREE SERVICE
			     --  ===================================================== */
			    
			     --ISBLANK('Dim Chassis'[ACTIVE])   &&
			    TotalServiceCount = 0 
			        && SaleDays >= 350
			        && SaleDays <= 365,
			        "CALL FOR THIRD SERVICE",
			    -- ISBLANK('Dim Chassis'[ACTIVE])   &&   
			    LastServiceType = "FREE 02"
			        && SaleDays >= 350
			        && SaleDays <= 365,
			        "CALL FOR THIRD SERVICE",
			    -- ISBLANK('Dim Chassis'[ACTIVE])   &&
			    LastServiceType = "FREE 02"
			        && SaleDays > 365
			        && SaleDays <= 380,
			        "TS MISSED",
			     --ISBLANK('Dim Chassis'[ACTIVE])   &&
			    TotalServiceCount = 0
			        && SaleDays > 365
			        && SaleDays <= 380,
			        "TS MISSED"
			        ,
			  /* =====================================================
			       PAID SERVICE
			       ===================================================== */
			
			    LastServiceType IN {
			        "FREE 03",
			        "PAID",
			        "REPAIR JOB",
			        "MINOR",
			        "GENERAL REPAIRS",
			        "MINOR REPAIRS"
			    }
			        && ServiceDays > 155
			        && ServiceDays <= 180,
			        "CALL FOR PAID SERVICE",
			
			    LastServiceType IN {
			        "FREE 03",
			        "PAID",
			        "REPAIR JOB",
			        "MINOR",
			        "GENERAL REPAIRS",
			        "MINOR REPAIRS"
			    }
			        && ServiceDays > 180
			        && ServiceDays <= 270,
			        "PAID MISSED"
			,
			  /* =====================================================
			       NEVER SERVICED - 545+ DAYS
			       ===================================================== */
			
			    TotalServiceCount = 0
			        && LoginDays > 545, "DEAD",
			    TotalServiceCount > 0
			        && ServiceDays > 545, "DEAD",
			
			   /* =====================================================
			       PREVIOUSLY SERVICED BUT 365+ DAYS NO VISIT
			       ===================================================== */
			-- WE CAN PROVIDE OFFER THEM
			
			   TotalServiceCount = 0
			        && SaleDays > 380
			        && SaleDays <= 545,
			        "NEVER SERVICED",
			
			    TotalServiceCount > 0 && TotalServiceCount <=3
			        && ServiceDays > 365 && ServiceDays <= 545 ,
			        "INACTIVE FROM 1 YEAR WITH <= 3",
			    
			    TotalServiceCount > 3
			        && ServiceDays > 365 && ServiceDays <= 545 ,
			        "INACTIVE FROM 1 YEAR WITH >3",
			
			    LastServiceType IN {
			        "FREE 03",
			        "PAID",
			        "REPAIR JOB",
			        "MINOR",
			        "GENERAL REPAIRS",
			        "MINOR REPAIRS"} &&
			  TotalServiceCount > 0
			        && ServiceDays > 270
			        && ServiceDays <= 365,
			        "IN-ACTIVE RECENTLY"    
			        ,
			
			LastServiceType IN {
			        "FREE 03",
			        "PAID",
			        "REPAIR JOB",
			        "MINOR",
			        "GENERAL REPAIRS",
			        "MINOR REPAIRS"
			    }
			        && ServiceDays >= 0
			        && ServiceDays <= 155, "ACTIVE",
			
			LastServiceType IN {
			        "FREE 01",
			        "FREE 02" } &&
			ServiceDays >0 && ServiceDays <= 190,"ACTIVE",
			
				 /* =====================================================
			       FIRST FREE SERVICE  ServiceDays 
			       ===================================================== */
			
			    TotalServiceCount = 0
			        && SaleDays < 15,
			        "NEW VEHICLE",
			
			    TotalServiceCount = 0
			        && IF(ISBLANK(SaleDays),LoginDays,SaleDays) >= 15
			        && IF(ISBLANK(SaleDays),LoginDays,SaleDays) <= 30,
			        
			        "CALL FOR FIRST SERVICE",
			
			    TotalServiceCount = 0
			        && IF(ISBLANK(SaleDays),LoginDays,SaleDays) > 30
			        && IF(ISBLANK(SaleDays),LoginDays,SaleDays) < 155,
			        "FS MISSED",
			
			        /* =====================================================
			       SECOND FREE SERVICE ServiceDays 
			       ===================================================== */
			     --ISBLANK('Dim Chassis'[ACTIVE]) &&
			    TotalServiceCount = 0 
			        && SaleDays >= 155
			        && SaleDays <= 180,
			        "CALL FOR SECOND SERVICE",
			     --ISBLANK('Dim Chassis'[ACTIVE])   &&
			    LastServiceType = "FREE 01"
			        && ServiceDays >= 155
			        && ServiceDays <= 180,
			        "CALL FOR SECOND SERVICE",
			     --ISBLANK('Dim Chassis'[ACTIVE])   &&
			    LastServiceType = "FREE 01"
			        && ServiceDays > 180
			        && ServiceDays <= 365,
			        "SS MISSED",
			     
			    
			        //* =====================================================
			     --  THIRD FREE SERVICE ServiceDays 
			     --  ===================================================== */
			    
			     --ISBLANK('Dim Chassis'[ACTIVE])   &&
			    TotalServiceCount = 0 
			        && SaleDays >= 350
			        && SaleDays <= 365,
			        "CALL FOR THIRD SERVICE",
			     --ISBLANK('Dim Chassis'[ACTIVE])   &&   
			    LastServiceType = "FREE 02"
			        && ServiceDays >= 180
			        && ServiceDays <= 365,
			        "CALL FOR THIRD SERVICE",
			    -- ISBLANK('Dim Chassis'[ACTIVE])   &&
			    LastServiceType = "FREE 02"
			        && ServiceDays > 365
			        && ServiceDays <= 380,
			        "TS MISSED"
			        )
			
			```
		lineageTag: 8eeed65f-baf7-4eb0-922c-1b536d4425a2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

