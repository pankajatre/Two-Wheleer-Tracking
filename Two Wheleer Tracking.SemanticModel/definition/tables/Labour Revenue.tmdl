table 'Labour Revenue'
	lineageTag: dab74772-706e-4317-980e-1099ca1746d4

	measure 'Total Service Labour (Exc GST)' = ```
			
			VAR Service_Labour = 
			DIVIDE(
			    SUM('Fact Service Raw'[Labour_Revenue]),
			    1.18)
			
			Var CLAIMED_Service_Labour = 
			DIVIDE(
			    SUM('Fact Service Raw'[Claimed_Labour_Amount]),
			    1.18)
			
			Var FSC_Labour = 
			DIVIDE(
			    SUM('Fact Service Raw'[Claimed_FSC_Labour_Amount]),
			    1.18)
			
			RETURN Service_Labour + CLAIMED_Service_Labour + FSC_Labour
			```
		lineageTag: ab3aadd8-f169-45cc-90f8-22a5329bfc43

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Service Labour' = ```
			
			VAR Service_Labour = 
			    SUM('Fact Service Raw'[Labour_Revenue])
			
			Var CLAIMED_Service_Labour = 
			    SUM('Fact Service Raw'[Claimed_Labour_Amount])
			 
			Var FSC_Labour = 
			    SUM('Fact Service Raw'[Claimed_FSC_Labour_Amount])
			
			RETURN Service_Labour + CLAIMED_Service_Labour + FSC_Labour
			```
		lineageTag: a312da1e-2cbe-4952-9839-1c5f79d2f0cf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YTD Labour Revenue' = TOTALYTD([Total Service Labour (Exc GST)],Dim_Date[Date],"31/3")
		lineageTag: 077fd6a0-caff-40bb-9a5d-a6cb6537f794

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YTD Per Vehicle Labour Revenue' = DIVIDE([YTD Labour Revenue],[YTD Job Card])
		lineageTag: 0a18b2cc-18c4-454b-a5ba-80727eaeef23

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'LYTD Labour Revenue' = CALCULATE( [YTD Labour Revenue],DATESYTD(DATEADD(Dim_Date[Date],-1,YEAR)))
		lineageTag: 9f92a0a3-e93e-40e0-8eed-90f8195c0959

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Labour Revenue Growth YTDvsLYTD' = DIVIDE([YTD Labour Revenue],[LYTD Labour Revenue])-1
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9da3bd19-3bd8-471f-b035-c7c8551f3497

	measure 'LYTD Per Vehicle Labour Revenue' = DIVIDE([LYTD Labour Revenue],[LYTD Job Card])
		lineageTag: 1efbce1b-41b1-42f3-9a04-b92424eb5485

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MTD Per Vehicle Labour Revenue' = DIVIDE([MTD labour Revenue],[MTD Job Card])
		lineageTag: 5a7d254a-6e7c-4278-bbb1-517b878cd88f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MTD LABOUR REVENUE' = TOTALMTD([Total Service Labour (Exc GST)],Dim_Date[Date])
		lineageTag: 0e37e06f-39d2-4bcc-b27c-3859d8bbb06f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'LMTD LABOUR REVENUE' = CALCULATE([MTD LABOUR REVENUE],DATEADD(Dim_Date[Date],-1,MONTH))
		lineageTag: b25b6b83-6cbf-4cee-a508-52c181782466

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'LMTD TLD Labour Revenue' =
			
			VAR CutoffDay =
			    DAY(
			        CALCULATE(
			            MAX('Fact Service Raw'[Job_Card_Closed_Date]),
			            ALL(Dim_Date)
			        )
			    )
			VAR LastDates =
			    MAX(Dim_Date[Date])
			RETURN
			CALCULATE(
			    [Total Service Labour (Exc GST)],
			    DATESBETWEEN(
			        Dim_Date[Date],
			        EOMONTH(LastDates,-2)+1,
			        DATE(
			            YEAR(EDATE(LastDates,-1)),
			            MONTH(EDATE(LastDates,-1)),
			            CutoffDay
			        )
			    )
			)
		lineageTag: 9e97a925-1bf0-4db2-9b38-c02fd212036c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Labour Revenue Growth MTDvsLMTD TLD' = DIVIDE([MTD LABOUR REVENUE],[LMTD Labour Revenue])-1
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a99b99a7-d2e1-46df-95d6-90814a8d715b

	measure 'LMTD TLD Per Vehicle Labour Revenue' = DIVIDE([LMTD TLD Labour Revenue],[LMTD TLD Job Card])
		lineageTag: 8cbbbc1f-183b-40a9-81bd-6ba7ae2923c1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'LMTD Per Vehicle Labour Revenue' = DIVIDE([LMTD labour Revenue],[LMTD Job Card])
		lineageTag: 86990aa2-aaee-44ea-9225-5c9fe21203e6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

