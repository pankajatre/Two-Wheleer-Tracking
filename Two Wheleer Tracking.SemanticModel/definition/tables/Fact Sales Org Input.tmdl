			    AddressText = Text.Upper(Text.From([Address_Line_1])),
			    Matches =
			        List.Select(
			            #"Colony List",
			            each Text.Contains(
			                AddressText,
			                Text.Upper(Text.From(_)),
			                Comparer.OrdinalIgnoreCase
			            )
			        )
			in
			    if List.Count(Matches) > 0 then Matches{0} else null),
