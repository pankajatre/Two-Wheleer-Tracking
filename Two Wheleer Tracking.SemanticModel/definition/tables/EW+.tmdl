	measure 'EW+ Convertion Delta MTD vs LMTD' = [MTD EW+ Convertion] - [LMTD TLD EW+ Convertion]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 693e6947-d80a-43f0-a305-719c8cac1b8d

	measure 'LYMTD EW+' = CALCULATE([MTD EW+], DATEADD(Dim_Date[Date],-1,YEAR))
		formatString: 0
