table '02 Free Service'
	lineageTag: a399484f-7f7f-4f9a-81d6-218cc75aa46f

	measure '1st Free Service' = ```
			
			CALCULATE(
			   [Total Service],
			   'Fact Service Raw'[Service_Type] = "Free 01",
			    FILTER(
			        ALL(Dim_Date),
			        Dim_Date[Year] = SELECTEDVALUE(Dim_Date[Year]) &&
			        Dim_Date[Date] <= DATE(SELECTEDVALUE('Dim_Date'[Year]), MONTH(TODAY()), DAY(TODAY()))
			    )
			)
			
			
			
			```
		formatString: 0
		lineageTag: d45fcdb5-e44a-42d2-b5ac-b80f11b8601c

